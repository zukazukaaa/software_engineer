{
  "name": "omega-emergence",
  "version": "0.1.0",
  "private": true,
  "description": "ΩE Core — Omega Emergence Universal Intelligence Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "domains/*"
  ],
  "scripts": {
    "build": "turbo run build",
