# ΩE Core — environment template
#
# Copy to `.env` (root) for dev. apps/api auto-loads this file when
# NODE_ENV !== 'production'. Production deployments inject env vars via
# Docker / systemd / k8s — never ship a real .env.

# Runtime mode: development | production | test
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://omega:omega@localhost:5432/omega_emergence?schema=public"

# Redis (rate limiting). Leave empty in dev to use a no-op limiter.
REDIS_URL="redis://localhost:6379"

# Auth
# In production set both secrets to long random values (≥32 bytes).
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# LLM providers
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7"
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Server
API_PORT=4000
API_HOST="0.0.0.0"
CONSOLE_PORT=5173

# Observability
SENTRY_DSN=""
LOG_LEVEL="info"
