# ΩE Core — environment template

# Database
DATABASE_URL="postgresql://omega:omega@localhost:5432/omega_emergence?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
