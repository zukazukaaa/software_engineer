# ΩE Core — environment template.
#
# Copy to `.env` (project root) for dev. apps/api auto-loads this file
# when NODE_ENV !== 'production' (see apps/api/src/bootstrap-env.ts).
# Production deployments inject env vars via Docker / systemd / k8s —
# never ship a real .env.

# Runtime mode: development | production | test
NODE_ENV="development"

# Database — matches docker-compose.yml service `postgres`.
DATABASE_URL="postgresql://omega:omega_dev@localhost:5432/omega_dev?schema=public"

# Redis — matches docker-compose.yml service `redis`.
REDIS_URL="redis://localhost:6379"

# Rate-limiter behaviour when Redis is unreachable:
#   open   → allow the request (dev convenience)
#   closed → block with 503 (production default)
REDIS_FAIL_MODE="closed"

# Auth — long random values (≥32 bytes) in production.
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# LLM providers
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7"
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Server
API_HOST="0.0.0.0"
API_PORT=4000
CONSOLE_PORT=5173

# Observability
SENTRY_DSN=""
LOG_LEVEL="info"
